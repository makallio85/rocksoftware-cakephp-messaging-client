{
    "name": "makallio85/rocksoftware-cakephp-messaging-client",
    "description": "CakePHP 5 plugin through which a Rock Software application sends email and SMS via the messaging gateway: send-once delivery, the delivery gate, the outbound message log, retries and the settings page.",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "email", "sms", "messaging"],
    "license": "proprietary",
    "authors": [
        {
            "name": "Marko Kallio",
            "email": "marko@rocksoftware.fi"
        }
    ],
    "require": {
        "php": ">=8.3",
        "cakephp/cakephp": "^5.2",
        "cakephp/migrations": "^4.0 || ^5.0"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "RockSoftware\\MessagingClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RockSoftware\\MessagingClient\\Test\\": "tests/",
            "TestApp\\": "tests/test_app/src/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "cs-check": "phpcs --colors -p src/ tests/",
        "cs-fix": "phpcbf --colors -p src/ tests/"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cakephp/plugin-installer": true
        }
    }
}
